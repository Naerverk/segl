# Optional: your Buy Me a Coffee page. Leave empty to hide the support link.
VITE_BUYMEACOFFEE_URL=
# Optional: base path when hosting in a sub-folder (e.g. GitHub Pages project site: /segl/)
VITE_BASE=/
# Optional override; defaults to https://github.com/Naerverk/segl.
VITE_SOURCE_URL=
# Optional: Yopass server for one-time password links (e.g. https://hemmelig.naerverk.no).
# Leave empty to hide the option; the app then never contacts any other server.
VITE_SECRET_SHARE_URL=
