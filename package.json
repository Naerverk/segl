{
  "name": "segl",
  "private": true,
  "version": "1.0.0",
  "description": "Prepare sensitive PDF documents for sharing – entirely in your browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/make-fixtures.ts",
    "icons": "node scripts/generate-icons.mjs",
    "deploy": "npm run build && npx --yes wrangler@4.162.0 pages deploy dist --project-name=segl --branch=main",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@neslinesli93/qpdf-wasm": "0.3.1",
    "lucide-react": "^1.73.0",
    "openpgp": "6.3.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
